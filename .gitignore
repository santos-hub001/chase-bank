# Dependencies
node_modules/

# =============================================================
# SQLite database — INCLUDED in this repo (tracked, committed)
#    pattern: ignore everything in data/  ->  re-include ONLY the DB
#    (demo data is build-seeded: chasebank.test emails, demo phones,
#     bcrypt-hashed passwords/PINs only. Registered users re-create on boot.)
data/*
!data/chasebank.db

# SQLite transient files — WAL/SHM/journal are run-time only, never committed
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/*-wal
data/*-shm

# Demo seed marker (readme for boot; not app data)
data/__boot.txt
data/*.txt

# Logs & scratch
*.log
*.done
ghlogin.out
server/_*
server/__*
server/debug-*.js
server/_probe_*.js
server/browsershots/
public/browsershots/
server/puppeteer-*

# Deploy helper (one-time, needs your interactive GitHub login — stays local)
deploy-to-github.ps1

# OS / editor
Thumbs.db
Desktop.ini
.vscode/
.DS_Store

# array: my interactive gh-login scratch leak (device-code only, not a credential, but shouldn't ship)
ghlogin.out
