# Dependencies
node_modules/

# Critical app data (SQLite database) — INCLUDED in this repo
# (user data here is demo/build-seeded: chasebank.test emails, demo phones,
#  bcrypt-hashed passwords/PINs only. Registered users re-created on first boot.)
data/chasebank.db

# SQLite transient files — WAL/SHM/journal are run-time only, never committed
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/*-wal
data/*-shm

# Demo seed marker (readme for boot; not app data)
data/__boot.txt
data/*.txt

# Logs & scratch
*.log
*.done
server/_*
server/__*
server/debug-*.js
server/_probe_*.js
server/browsershots/
public/browsershots/
server/puppeteer-*

# Deploy helper (one-time, needs your interactive GitHub login — stays local)
deploy-to-github.ps1

# OS / editor
Thumbs.db
Desktop.ini
.vscode/
.DS_Store
